{
	"name": "ftpdelta",
	"version": "1.0.0",
	"description": "CLI tool to sync local folders to FTP by uploading only new or modified files",
	"type": "module",
	"main": "dist/sync.js",
	"types": "dist/sync.d.ts",
	"bin": {
		"ftpdelta": "./dist/bin/ftpdelta.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"prepare": "npm run build",
		"start": "node dist/bin/ftpdelta.js",
		"dev": "node --loader ts-node/esm dist/bin/ftpdelta.ts",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/iMarti/FtpDelta.git"
	},
	"keywords": [
		"ftp",
		"sync",
		"upload",
		"cli",
		"delta",
		"incremental"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"basic-ftp": "^5.0.5",
		"commander": "^12.0.0",
		"fs-extra": "^11.2.0",
		"glob": "^10.3.10"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.10.6",
		"typescript": "^5.3.3"
	}
}